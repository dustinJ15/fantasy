# Copy to .env. Get these via scripts/setup_cookies.md
ESPN_S2=
SWID={...}
SEASON=2026
# optional
DISCORD_WEBHOOK=
# email delivery, first path: the Apps Script relay over HTTPS (scripts/gmail_send_relay.md; the only path the cloud proxy carries)
FF_MAIL_RELAY_URL=
FF_MAIL_RELAY_TOKEN=
# second path, used only when the relay vars are absent: Gmail SMTP (Google account > Security > 2-Step Verification > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
BRIEFING_TO=
# dead-man's switch: create a free check at healthchecks.io with a daily period and ~2h grace, paste its ping URL
HEALTHCHECK_URL=
